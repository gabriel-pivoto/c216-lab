# Connection used by the app and by Alembic when they run outside Docker.
# Inside docker compose the backend gets a DATABASE_URL pointing at the "db" host.
DATABASE_URL=postgresql+psycopg://c216:c216@localhost:5432/c216

# Database used by the integration tests (created automatically; its data is wiped)
TEST_DATABASE_URL=postgresql+psycopg://c216:c216@localhost:5432/c216_test
